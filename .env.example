# Kanban Board — environment variables (SPEC §10.2)
# Copy this file to `.env` and adjust if needed. `.env` is gitignored.
# Defaults below work out of the box with `docker compose up -d`.

# --- PostgreSQL container (compose.yaml) ---
POSTGRES_DB=kanban
POSTGRES_USER=kanban
# Development-only credential. Never use in production.
POSTGRES_PASSWORD=kanban_dev
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
DB_URL=jdbc:postgresql://localhost:5432/kanban
DB_USER=kanban
DB_PASSWORD=kanban_dev
SERVER_PORT=8080
